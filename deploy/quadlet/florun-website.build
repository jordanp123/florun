# Builds the site image from the git checkout, so a cold
# `systemctl --user start florun-website.service` works without a manual build.
# The daily florun-update.sh rebuilds this same tag with --pull (base-image
# freshness), so day to day this unit is only the cold-start path.
#
# The build context IS the checkout: every file the image needs is version
# controlled, and .dockerignore is an allowlist, so .git, deploy/ and tests/
# never enter the context. deploy/install.sh rewrites %h/florun to your actual
# install directory and BuildArg SUBPATH from config.florun, so nothing here
# needs hand-editing if you install with that script.
[Unit]
Description=Build the FloRun site image

[Build]
ImageTag=localhost/florun-website:latest
File=%h/florun/Dockerfile
SetWorkingDirectory=%h/florun
BuildArg=SUBPATH=.
